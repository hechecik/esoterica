    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@photostructure/tz-lookup": "^11.8.0",
    "@swisseph/browser": "^1.4.0",
    "motion": "^14.14.0"
  }
